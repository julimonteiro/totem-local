// Beginner TOTEM: QWERTY, dedicated modifiers, three layers.
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        base {
            label = "BASE";
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P
                &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI
                &kp ESC  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH  &kp BSPC
                &kp LCTRL  &kp LGUI  &kp SPACE  &kp ENTER  &mo 1  &kp LSHFT
            >;
        };
        navigation {
            label = "NAV";
            bindings = <
                &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
                &kp TAB  &kp HOME  &kp UP  &kp END  &kp PG_UP  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH
                &mo 2  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN  &kp DELETE  &kp COMMA  &kp DOT  &kp SEMI  &kp SQT  &kp GRAVE  &kp BSPC
                &kp LALT  &trans  &trans  &trans  &trans  &trans
            >;
        };
        adjust {
            label = "AJUSTES";
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &none  &bt BT_CLR
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
